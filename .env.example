APP_NAME="Trade School AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
# Connects to the local Docker container running pgvector/pgvector:pg16
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vectors_postgres_slow
DB_USERNAME=postgres
DB_PASSWORD=secret

# -----------------------------------------------------------------------------
# AI & Embedding Provider Configuration
# -----------------------------------------------------------------------------
# OPTION 1: Local Offline AI via Ollama (Default - 100% Free & Private)
# Requires: brew install ollama && ollama pull nomic-embed-text
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=512

# OPTION 2: Cloud OpenAI API (Production Setup)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-your-api-key-here
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=512

# RAG & Chat Assistant Model
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_TEMPERATURE=0.1
AI_MIN_SIMILARITY_THRESHOLD=0.60

# -----------------------------------------------------------------------------
# Cache, Session, & Queue Configuration
# -----------------------------------------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=slow_lane_
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=slow_session
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Logging & Mail
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Frontend & Vite
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
